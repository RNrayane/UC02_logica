programa {
    funcao inicio () {
     // declaração
        real precolitro, litros, total
     // entrada
        escreva("preço do litro de gasolina em maceió")
        leia(precolitro)
        escreva("quantos litros abasteceu: ")
        leia(litros)
     //processamento
        total = precolitro * litros
     // saida
        escreva("total a pagar: R$", total, "\n") 


    }
}