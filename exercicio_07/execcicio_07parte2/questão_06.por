programa{
    funcao inicio () {
       real media, frequencia
       escreva("digite a meidia do aluno: ")
       leia(media)
       escreva("digite a frequencia do aluno: ")
       leia(frequencia)
       se (media >= 8.0 e frequencia > 75)
       {
        escreva("inscrição aprovada!")
       }
       senao
       {
        escreva("inscrição nao aprovada!")
       }
    }
}