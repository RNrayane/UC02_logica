programa{
    funcao inicio () {
        real idade 
        cadeia estudante
        escreva("digite a idade do torcerdo: ")
        leia(idade)
        escreva("possui carterinha estudantiu?: ")
        leia(estudante)
        se ("idade < 12 ou estudante == verdadeiro")
        {
         escreva("tem direito a meia-entrada")
        }
        senao
        {
         escreva(" nao tem direito a maia-entrada")
        }         
    }
} 