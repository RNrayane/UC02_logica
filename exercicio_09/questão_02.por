programa{
    funcao inicio() {
        real mare 
        cadeia chuvoso 
        escreva("digite a altura da mare: ")
        leia(mare)
        escreva("o tempo esta chuvoso?: ")
        leia(chuvoso)

        se (mare <= 0.4 e chuvoso == "nao") {
            escreva("passeio liberado: verdadeiro")
        } senao {
        escreva ("passeio liberado: falso")
        
        }
    }
}