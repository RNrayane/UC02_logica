programa{
    funcao inicio () {
       real mare
       cadeia noite
       escreva("digite a altura  da mare")
       leia(mare)
       escreva("esta de noite?")
       leia(noite)
       se ("mare < 0.2 e noite == falso")
       {
        escreva("caminhada viavel")
        }
        senao
        {
        escreva("caminhada nao viavel")
        }    
    }
}