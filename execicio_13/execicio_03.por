programa {
    funcao inicio () {
     // declaração
      real nota1, nota2, nota3, media
     // entrada
       escreva("Nota 1:")
        leia(nota1)
        escreva("Nota 2:")
        leia(nota2)
        escreva("Nota 3: ")
        leia(nota3)
      // processamento
      media = (nota1 + nota2 + nota3) / 3
      //saida
      escreva("Média: ", media, "\n")
      
    }
}