programa {
    funcao inicio () {
     // declaração
     real largura, comprimento, area
     // entrada
     escreva("largura (m): ")
     leia(largura)
     escreva("comprimento (m): ")
     leia(comprimento)
      // processamento
     area = largura + comprimento 
      //saida
      escreva("area:", area, "m²\n")
    }
}