programa {
  funcao inicio() {
   real ingresso, meiaEntrada, inteiraAlunos, total
   escreva("digite o valor do ingresso inteiro: ")
   leia(ingresso)
   escreva("digite o numero de inteiraAlunos: ")
   leia(inteiraAlunos) 
   meiaEntrada = ingresso / 2
   total = meiaEntrada * inteiraAlunos
   escreva("valor da meia-entrada: ", meiaEntrada)
   escreva("custo total do grupo: ", total)



  }
}
