programa {
  funcao inicio() {
  inteiro arquibancadas, cadeiras, total
  escreva("digite o numero de torcedor nas arquibancadas")
  leia(arquibancadas)
  escreva("digite o numero de torcedor nas cadeiras especias")
  leia(cadeiras)
  total = arquibancadas + cadeiras
  escreva("publico total do estadio: ", total)

  }
}
