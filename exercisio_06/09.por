programa {
  funcao inicio() {
  real distancia, litros, consumo
  escreva("digite a distancia total percorrida em km")
  leia(distancia)
escreva("digite a quantida de combustivel consumida em litros: ")
leia( litros)
consumo = distancia / litros
 escreva("o carro percorreu ", consumo, "km por litro." ) 
  }
}
